{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "lib": ["ES2022", "DOM"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "noImplicitAny": true,
        "noUnusedLocals": false,
        "outDir": "./out",
        "rootDir": ".",
        "types": ["node"]
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "out", ".vscode-test"]
}
